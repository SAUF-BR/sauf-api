# Copie para .env e preencha. O .env NÃO vai para o Git.

# Banco local (Docker): docker compose up -d (ver README). Credenciais só de dev local.
SAUF_DB_URL=jdbc:postgresql://localhost:5433/sauf
SAUF_DB_USER=sauf
SAUF_DB_PASSWORD=sauf

# Supabase (compartilhado): só recebe o que está na main. Para usar, comente o bloco local
# acima e descomente este. Project Settings > Database > Connection string > Session pooler (JDBC).
# SAUF_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# SAUF_DB_USER=postgres.SEU_PROJECT_REF
# SAUF_DB_PASSWORD=troque-pela-senha-do-banco

# Origens do front liberadas no CORS, separadas por vírgula.
SAUF_CORS_ORIGENS=http://localhost:5173

# Segredo das rotas /api/v1/ingestao/** (header X-Api-Key). Use o mesmo valor no
# SAUF_API_KEY do sauf-scraper. Sem ele, a ingestão fica desabilitada.
SAUF_API_KEY=troque-por-um-segredo-longo

# Stripe (ADR-BE-016), sempre em MODO TESTE (chaves sk_test_...). Sem a chave, os pagamentos
# ficam desabilitados e o resto da API funciona normalmente.
# Dashboard Stripe > Developers > API keys.
STRIPE_SECRET_KEY=sk_test_troque
# Segredo do webhook (whsec_...). Local: é impresso pelo `stripe listen` (ver README).
STRIPE_WEBHOOK_SECRET=whsec_troque
# IDs dos preços do Product "Assinatura SAUF.BR" (Dashboard > Product catalog).
STRIPE_PRICE_BASIC=price_troque
STRIPE_PRICE_PLUS=price_troque
STRIPE_PRICE_PREMIUM=price_troque
# Para onde o Stripe devolve o usuário (opcional; o padrão aponta para o front local).
# STRIPE_URL_SUCESSO=http://localhost:5173/perfil/assinatura?checkout=sucesso
# STRIPE_URL_CANCELAMENTO=http://localhost:5173/perfil/assinatura?checkout=cancelado
# STRIPE_URL_RETORNO_PORTAL=http://localhost:5173/perfil/assinatura
