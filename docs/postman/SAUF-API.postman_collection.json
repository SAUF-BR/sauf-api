            "description": "ATENÇÃO: grava no banco configurado na API (o Supabase). Usa uma instituição fictícia (e-MEC 999999) para não sobrescrever a UEM, mas ela aparece nas listagens. Prefira popular com o sauf-scraper e use este exemplo só para testar validação.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anoCenso\": 2024,\n  \"instituicoes\": [\n    {\n      \"codigoEmec\": 999999,\n      \"nome\": \"Instituição de Teste Postman\",\n      \"sigla\": \"ITP\",\n      \"tipo\": \"publica\",\n      \"categoriaAdministrativa\": \"Pública Estadual\",\n      \"organizacaoAcademica\": \"Universidade\",\n      \"uf\": \"PR\",\n      \"cidade\": \"Maringá\"\n    }\n  ],\n  \"ofertas\": [\n    {\n      \"codigoEmec\": 9999901,\n      \"codigoEmecInstituicao\": 999999,\n      \"nome\": \"Engenharia de Software\",\n      \"grau\": \"bacharelado\",\n      \"modalidade\": \"presencial\",\n      \"cidade\": \"Maringá\",\n      \"uf\": \"PR\",\n      \"vagas\": 40,\n      \"gratuito\": true,\n      \"codigoCineRotulo\": \"0613E01\",\n      \"nomeCineRotulo\": \"Engenharia de software\",\n      \"codigoCineArea\": \"06\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ingestao/censo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingestao",
                "censo"
              ]
            }
